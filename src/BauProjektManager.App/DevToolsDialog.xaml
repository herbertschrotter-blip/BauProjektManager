<Window x:Class="BauProjektManager.App.DevToolsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev Tools [DEBUG]"
        Width="780" Height="720"
        MinWidth="740" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BpmBgBase}"
        ResizeMode="CanResize"
        Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab-Style via Default aus Dialogs.xaml (BpmTabControl + BpmTabItem) -->
        <TabControl Grid.Row="0">

            <!-- TAB 1: SYSTEM-INFO -->
            <TabItem><TabItem.Header><TextBlock><Run Text="{StaticResource IconActionCopy}"/><Run Text=" System-Info"/></TextBlock></TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource BpmBgElevated}"
                            CornerRadius="4" Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="App-Version" Style="{StaticResource BpmLabel}" Padding="12,8" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAppVersion" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET Runtime" Style="{StaticResource BpmLabel}" Padding="12,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRuntime" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Windows" Style="{StaticResource BpmLabel}" Padding="12,8" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtWindows" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Background="{StaticResource BpmBgSurface}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Rechner" Style="{StaticResource BpmLabel}" Padding="12,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtMachine" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Benutzer" Style="{StaticResource BpmLabel}" Padding="12,8" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtUser" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Monitore" Style="{StaticResource BpmLabel}" Padding="12,8"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtResolution" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Auflösung" Style="{StaticResource BpmLabel}" Padding="12,8" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtDpi" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Datenbank" Style="{StaticResource BpmLabel}" Padding="12,8"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TxtDbPath" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Foreground="{StaticResource BpmAccentPrimary}" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="7" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <Button Content="📁" Style="{StaticResource BpmButtonGhost}" Padding="6,2" MinWidth="0" ToolTip="Ordner oeffnen" Click="OnPathOpenFolder" Tag="{Binding Text, ElementName=TxtDbPath}"/>
                                    <Button Content="📄" Style="{StaticResource BpmButtonGhost}" Padding="6,2" MinWidth="0" Margin="2,0,0,0" ToolTip="Mit Standard-App oeffnen" Click="OnPathOpenWithDefault" Tag="{Binding Text, ElementName=TxtDbPath}"/>
                                    <Button Content="🎯" Style="{StaticResource BpmButtonGhost}" Padding="6,2" MinWidth="0" Margin="2,0,0,0" ToolTip="Im Explorer markieren" Click="OnPathRevealInExplorer" Tag="{Binding Text, ElementName=TxtDbPath}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="DB-Größe" Style="{StaticResource BpmLabel}" Padding="12,8" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" x:Name="TxtDbSize" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Freier Speicher" Style="{StaticResource BpmLabel}" Padding="12,8"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" x:Name="TxtFreeSpace" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Einstellungen" Style="{StaticResource BpmLabel}" Padding="12,8" Background="{StaticResource BpmBgSurface}"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" x:Name="TxtSettingsPath" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Foreground="{StaticResource BpmAccentPrimary}" Background="{StaticResource BpmBgSurface}" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="10" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Background="{StaticResource BpmBgSurface}" Margin="4,0,8,0">
                                    <Button Content="📁" FontSize="14" Background="{StaticResource BpmBgInput}" BorderBrush="{StaticResource BpmBorderDefault}" BorderThickness="1" Padding="6,3" MinWidth="32" ToolTip="Ordner oeffnen" Click="OnPathOpenFolder" Tag="{Binding Text, ElementName=TxtSettingsPath}"/>
                                    <Button Content="📄" FontSize="14" Background="{StaticResource BpmBgInput}" BorderBrush="{StaticResource BpmBorderDefault}" BorderThickness="1" Padding="6,3" MinWidth="32" Margin="3,0,0,0" ToolTip="Mit Standard-App oeffnen" Click="OnPathOpenWithDefault" Tag="{Binding Text, ElementName=TxtSettingsPath}"/>
                                    <Button Content="🎯" FontSize="14" Background="{StaticResource BpmBgInput}" BorderBrush="{StaticResource BpmBorderDefault}" BorderThickness="1" Padding="6,3" MinWidth="32" Margin="3,0,0,0" ToolTip="Im Explorer markieren" Click="OnPathRevealInExplorer" Tag="{Binding Text, ElementName=TxtSettingsPath}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Log-Verzeichnis" Style="{StaticResource BpmLabel}" Padding="12,8"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" x:Name="TxtLogPath" Style="{StaticResource BpmSmallText}" Padding="12,8" FontFamily="Consolas" Foreground="{StaticResource BpmAccentPrimary}" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="11" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <Button Content="📁" FontSize="14" Background="{StaticResource BpmBgInput}" BorderBrush="{StaticResource BpmBorderDefault}" BorderThickness="1" Padding="6,3" MinWidth="32" ToolTip="Ordner oeffnen" Click="OnPathOpenFolder" Tag="{Binding Text, ElementName=TxtLogPath}"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Style="{StaticResource BpmButtonSecondary}"
                                Click="OnCopyBugReport" Margin="0,0,8,0">
                            <Button.Content><TextBlock><Run Text="{StaticResource IconActionCopy}"/><Run Text=" System-Info + Log kopieren"/></TextBlock></Button.Content>
                        </Button>
                        <Button Style="{StaticResource BpmButtonSecondary}"
                                Click="OnOpenLogs">
                            <Button.Content><TextBlock><Run Text="{StaticResource IconFolderOpen}"/><Run Text=" Log-Ordner öffnen"/></TextBlock></Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: LOG -->
            <TabItem><TabItem.Header><TextBlock><Run Text="{StaticResource IconFile}"/><Run Text=" Log"/></TextBlock></TabItem.Header>
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <!-- Aktions-Buttons rechts (zuerst gedockt, damit sie am rechten Rand kleben) -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource BpmButtonSecondary}" Click="OnCopyLog" Margin="8,0,0,0">
                                <Button.Content><TextBlock><Run Text="{StaticResource IconActionCopy}"/><Run Text=" Kopieren"/></TextBlock></Button.Content>
                            </Button>
                            <Button Content="↻ Aktualisieren" Style="{StaticResource BpmButtonSecondary}" Click="OnRefreshLog" Margin="8,0,0,0"/>
                        </StackPanel>
                        <!-- Filter-Gruppe links (fuellt den Restplatz dynamisch bei Resize) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Anzeigen:" Style="{StaticResource BpmLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbLogFilter"
                                      Width="200" MinHeight="28"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="OnLogFilterChanged">
                                <ComboBoxItem Content="Letzte 200 Zeilen" Tag="last200Lines"/>
                                <ComboBoxItem Content="Letzte N Zeilen (eigene)" Tag="lastNLines"/>
                                <ComboBoxItem Content="Aktuelle Session" Tag="currentSession"/>
                                <ComboBoxItem Content="Letzte Session" Tag="previousSession"/>
                                <ComboBoxItem Content="Komplettes Logfile" Tag="entireFile"/>
                                <ComboBoxItem Content="Bestimmte Session..." Tag="specificSession"/>
                            </ComboBox>
                            <TextBox x:Name="TxtCustomLineCount"
                                     Width="70" MinHeight="28"
                                     Margin="8,0,0,0"
                                     Background="{StaticResource BpmBgInput}"
                                     Foreground="{StaticResource BpmTextPrimary}"
                                     BorderBrush="{StaticResource BpmAccentPrimary}"
                                     FontFamily="Consolas"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0"
                                     Visibility="Collapsed"
                                     LostFocus="OnCustomLineCountChanged"
                                     KeyDown="OnCustomLineCountKeyDown"/>
                            <TextBlock x:Name="TxtLineRange"
                                       Text="(10-10000)"
                                       Style="{StaticResource BpmSmallText}"
                                       Foreground="{StaticResource BpmTextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       Visibility="Collapsed"/>
                            <ComboBox x:Name="CmbSession"
                                      Width="180" MinHeight="28"
                                      Margin="8,0,0,0"
                                      VerticalContentAlignment="Center"
                                      Visibility="Collapsed"
                                      SelectionChanged="OnSessionChanged"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Status-Hinweis -->
                    <TextBlock Grid.Row="1"
                               x:Name="TxtLogStatus"
                               Style="{StaticResource BpmSmallText}"
                               Foreground="{StaticResource BpmTextSecondary}"
                               Margin="0,0,0,8"
                               Text=""/>
                    <!-- Warnung bei großen Files / fehlenden Sessions -->
                    <Border Grid.Row="2"
                            x:Name="BorderLogWarning"
                            Background="{StaticResource BpmBadgeBgWarning}"
                            BorderBrush="{StaticResource BpmWarning}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="TxtLogWarning"
                                   Style="{StaticResource BpmSmallText}"
                                   Foreground="{StaticResource BpmWarning}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="3"
                            Background="{StaticResource BpmBgElevated}"
                            CornerRadius="4"
                            BorderBrush="{StaticResource BpmBorderDefault}"
                            BorderThickness="1">
                        <ScrollViewer x:Name="LogScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtLogContent"
                                       FontFamily="Consolas" FontSize="11"
                                       Background="Transparent"
                                       Padding="12" TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: RESET -->
            <TabItem><TabItem.Header><TextBlock><Run Text="{StaticResource IconActionDelete}"/><Run Text=" Reset"/></TextBlock></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Quick-Resets"
                                   Style="{StaticResource BpmHeading3}"/>
                        <TextBlock Text="Klick markiert die zugehoerigen Eintraege im Persistenz-Inventar unten. Loeschen via 'Ausgewaehlte loeschen'."
                                   Style="{StaticResource BpmSmallText}"
                                   Foreground="{StaticResource BpmTextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,12">

                        <!-- Option 1: Nur Ersteinrichtung — GRÜN (sicher) -->
                        <Border x:Name="BorderFirstRun"
                                Background="{StaticResource BpmBgElevated}"
                                BorderBrush="{StaticResource BpmBorderDefault}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12,10" Margin="0,0,8,8" Width="320"
                                Cursor="Hand" MouseLeftButtonDown="OnQuickSelect" Tag="FirstRun">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⟳" FontSize="18"
                                           Foreground="{StaticResource BpmSuccess}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nur Ersteinrichtung" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BpmTextPrimary}"/>
                                    <TextBlock Text="Ersteinrichtungs-Dialog beim nächsten Start. Daten und Pfade bleiben erhalten."
                                               FontSize="11" Foreground="{StaticResource BpmTextSecondary}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Option 2: Nur Datenbank — GELB (Warnung) -->
                        <Border x:Name="BorderDbOnly"
                                Background="{StaticResource BpmBgElevated}"
                                BorderBrush="{StaticResource BpmBorderDefault}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12,10" Margin="0,0,8,8" Width="320"
                                Cursor="Hand" MouseLeftButtonDown="OnQuickSelect" Tag="DbOnly">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🗑" FontSize="18"
                                           Foreground="{StaticResource BpmWarning}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nur Datenbank" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BpmTextPrimary}"/>
                                    <TextBlock Text="Löscht alle Projektdaten (bpm.db + WAL/SHM). Einstellungen und Pfade bleiben erhalten."
                                               FontSize="11" Foreground="{StaticResource BpmTextSecondary}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Option 3: Nur Einstellungen — GELB (Warnung) -->
                        <Border x:Name="BorderSettingsOnly"
                                Background="{StaticResource BpmBgElevated}"
                                BorderBrush="{StaticResource BpmBorderDefault}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12,10" Margin="0,0,8,8" Width="320"
                                Cursor="Hand" MouseLeftButtonDown="OnQuickSelect" Tag="SettingsOnly">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🗑" FontSize="18"
                                           Foreground="{StaticResource BpmWarning}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nur Einstellungen" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BpmTextPrimary}"/>
                                    <TextBlock Text="Löscht Pfade und Konfiguration (settings.json). Projektdaten bleiben erhalten."
                                               FontSize="11" Foreground="{StaticResource BpmTextSecondary}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Option 4: Alles — ROT (Gefahr) -->
                        <Border x:Name="BorderAll"
                                Background="{StaticResource BpmBgElevated}"
                                BorderBrush="{StaticResource BpmBorderDefault}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12,10" Margin="0,0,8,8" Width="320"
                                Cursor="Hand" MouseLeftButtonDown="OnQuickSelect" Tag="All">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠" FontSize="18"
                                           Foreground="{StaticResource BpmError}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Alles — Kompletter Neustart" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BpmTextPrimary}"/>
                                    <TextBlock Text="Löscht Datenbank und alle Einstellungen. App startet wie beim allerersten Mal."
                                               FontSize="11" Foreground="{StaticResource BpmTextSecondary}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Option 5: Logs loeschen — GRÜN (kein Restart) -->
                        <Border x:Name="BorderLogs"
                                Background="{StaticResource BpmBgElevated}"
                                BorderBrush="{StaticResource BpmBorderDefault}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12,10" Margin="0,0,8,8" Width="320"
                                Cursor="Hand" MouseLeftButtonDown="OnQuickSelect" Tag="Logs">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🗑" FontSize="18"
                                           Foreground="{StaticResource BpmSuccess}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Nur Logs" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource BpmTextPrimary}"/>
                                    <TextBlock Text="Löscht alle Serilog-Logfiles (Logs/BPM_*.log). Kein Restart nötig."
                                               FontSize="11" Foreground="{StaticResource BpmTextSecondary}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </WrapPanel>

                    <!-- Detail-Auswahl: Persistenz-Inventar (BPM-104.04) -->
                    <TextBlock Grid.Row="2"
                               Text="Detail-Auswahl (Persistenz-Inventar)"
                               Style="{StaticResource BpmHeading3}"
                               Margin="0,16,0,8"/>

                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtInventoryStatus"
                                       Style="{StaticResource BpmSmallText}"
                                       Foreground="{StaticResource BpmTextSecondary}"
                                       Margin="0,0,0,8"
                                       Text="Inventar wird geladen ..."/>
                            <ItemsControl x:Name="LstInventory">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="GroupItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GroupItem">
                                                            <Border Background="{DynamicResource BpmBgElevated}"
                                                                    BorderBrush="{DynamicResource BpmBorderDefault}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <ToggleButton x:Name="ToggleHeader"
                                                                                  IsChecked="True"
                                                                                  Background="Transparent"
                                                                                  BorderBrush="{DynamicResource BpmBorderSubtle}"
                                                                                  BorderThickness="0,0,0,1"
                                                                                  Padding="10,8"
                                                                                  HorizontalContentAlignment="Stretch"
                                                                                  Cursor="Hand">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="False">
                                                                                        <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                        <DockPanel LastChildFill="True">
                                                                            <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="▾" Foreground="{DynamicResource BpmTextSecondary}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                            <CheckBox DockPanel.Dock="Left" IsThreeState="False" Click="OnGroupCheckClicked" Tag="{Binding Name}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Foreground="{DynamicResource BpmAccentPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                                            <TextBlock Foreground="{DynamicResource BpmTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                                <Run Text="("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" Eintraege)"/>
                                                                            </TextBlock>
                                                                        </DockPanel>
                                                                    </ToggleButton>
                                                                    <ItemsPresenter x:Name="ItemsHost" Margin="0,4,0,8"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger SourceName="ToggleHeader" Property="IsChecked" Value="False">
                                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="Chevron" Property="Text" Value="▸"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="32,5,12,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource BpmTextBright}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Border Background="{Binding ScopeColor}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScopeLabel}" Foreground="{DynamicResource BpmTextBright}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding AbsolutePath}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BpmTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource BpmTextPrimary}" FontSize="10" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource BpmTextSecondary}" FontSize="9" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="📁" FontSize="14" Background="{DynamicResource BpmBgInput}" BorderBrush="{DynamicResource BpmBorderDefault}" BorderThickness="1" Padding="6,3" MinWidth="32" Cursor="Hand" ToolTip="Ordner oeffnen" Click="OnPathOpenFolder" Tag="{Binding AbsolutePath}"/>
                                                <Button Content="📄" FontSize="14" Background="{DynamicResource BpmBgInput}" BorderBrush="{DynamicResource BpmBorderDefault}" BorderThickness="1" Padding="6,3" MinWidth="32" Margin="3,0,0,0" Cursor="Hand" ToolTip="Mit Standard-App oeffnen" Click="OnPathOpenWithDefault" Tag="{Binding AbsolutePath}"/>
                                                <Button Content="🎯" FontSize="14" Background="{DynamicResource BpmBgInput}" BorderBrush="{DynamicResource BpmBorderDefault}" BorderThickness="1" Padding="6,3" MinWidth="32" Margin="3,0,0,0" Cursor="Hand" ToolTip="Im Explorer markieren" Click="OnPathRevealInExplorer" Tag="{Binding AbsolutePath}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </StackPanel>

                    <!-- Warnung -->
                    <Border Grid.Row="4"
                            Background="{StaticResource BpmBadgeBgWarning}"
                            BorderBrush="{StaticResource BpmWarning}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="12,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BpmSmallText}"
                                       Foreground="{StaticResource BpmWarning}"
                                       TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="{StaticResource IconStatusWarning}"/><Run Text="  Quick-Reset (oben): App wird nach Aktion neu gestartet. Detail-Bulk-Reset (unten): geloeschte Files gehen unwiderruflich verloren."/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBulkDelete"
                                        Style="{StaticResource BpmButtonDanger}"
                                        Click="OnBulkDelete">
                                    <Button.Content><TextBlock x:Name="TxtBulkDeleteLabel"><Run Text="{StaticResource IconActionDelete}"/><Run Text=" Ausgewaehlte loeschen"/></TextBlock></Button.Content>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Button Grid.Row="1"
                Content="Schließen"
                Style="{StaticResource BpmButtonSecondary}"
                Click="OnClose"
                HorizontalAlignment="Right"
                Margin="20,12,20,12"
                Width="100"/>
    </Grid>
</Window>
