<Window x:Class="BauProjektManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BauProjektManager"
        Height="700" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- BPM-067: 220 (Text) oder 56 (Icons), wird im Code-Behind umgeschaltet -->
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Sidebar (BPM-067: klappbar, Mockup Docs/Mockups/App/01_Shell/01_Sidebar.html) -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource BpmBgElevated}">
            <DockPanel LastChildFill="True">

                <!-- Kopf: Titel + Chevron -->
                <Grid DockPanel.Dock="Top" Margin="0,8,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SidebarTitle"
                               Text="BauProjektManager"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource BpmTextBright}"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                    <Button x:Name="BtnSidebarToggle"
                            Grid.Column="1"
                            Click="OnToggleSidebar"
                            Style="{StaticResource BpmButtonNav}"
                            Foreground="{StaticResource BpmTextSecondary}"
                            FontSize="11"
                            Padding="10,8"
                            HorizontalContentAlignment="Center"
                            Content="{StaticResource IconNavCollapse}"/>
                </Grid>

                <!-- Fuss: Version (nur aufgeklappt) -->
                <TextBlock x:Name="SidebarVersion"
                           DockPanel.Dock="Bottom"
                           Style="{StaticResource BpmSmallText}"
                           Foreground="{StaticResource BpmTextSecondary}"
                           Margin="15,0,15,10"/>

                <!-- Modul-Navigation -->
                <StackPanel>
                    <Button x:Name="BtnPlans"
                            Click="OnNavigate" Tag="Plans"
                            Style="{StaticResource BpmButtonNav}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconNavPlans}"
                                           Width="26" TextAlignment="Center"/>
                                <TextBlock x:Name="PlansText" Text="PlanManager"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="SidebarBadge"
                                    Background="{StaticResource BpmWarning}"
                                    CornerRadius="8" Padding="5,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="6,0,0,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="SidebarBadgeText"
                                           Foreground="{StaticResource BpmTextBright}"
                                           FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="BtnSettings"
                            Click="OnNavigate" Tag="Settings"
                            Style="{StaticResource BpmButtonNav}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconNavSettings}"
                                       Width="26" TextAlignment="Center"/>
                            <TextBlock x:Name="SettingsText" Text="Einstellungen"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDevTools"
                            Click="OnOpenDevTools"
                            Style="{StaticResource BpmButtonNav}"
                            Foreground="{StaticResource BpmWarning}"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource IconNavDevTools}"
                                       Width="26" TextAlignment="Center"/>
                            <TextBlock x:Name="DevToolsText" Text="Dev Tools"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource BpmBgBase}">
            <ContentControl x:Name="ContentArea" Margin="20">
                <TextBlock Text="Willkommen im BauProjektManager"
                           Style="{StaticResource BpmHeading1}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </ContentControl>
        </Border>

        <!-- Statusleiste -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Background="{StaticResource BpmAccentPrimary}">
            <TextBlock x:Name="StatusText"
                       Text="Bereit | Kein Projekt geladen"
                       Foreground="{StaticResource BpmTextOnAccent}"
                       Style="{StaticResource BpmSmallText}"
                       VerticalAlignment="Center" Margin="10,0"/>
        </Border>
    </Grid>
</Window>
