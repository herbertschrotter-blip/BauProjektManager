<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════
         BauProjektManager — Typography.xaml
         Version: 1.1 | Datum: 13.11.2026 (Größen-Tokens, R01-009)
         Referenz: Docs/UI_UX_Guidelines.md Kapitel 4
         Schriftart: Segoe UI (Windows Standard)
         ═══════════════════════════════════════════════════════════ -->

    <!-- ── Schriftart ──────────────────────────────────────────── -->
    <FontFamily x:Key="BpmFontFamily">Segoe UI</FontFamily>

    <!-- ── Schriftgrößen-Tokens (UI_UX_Guidelines 4.2, R01-009) ──
         Einzige Quelle der Größen: Styles unten und Komponenten
         (Buttons, DataGrid, Dialoge, Views) referenzieren nur diese Keys. -->
    <sys:Double x:Key="BpmFontSizeH1">24</sys:Double>
    <sys:Double x:Key="BpmFontSizeH2">18</sys:Double>
    <sys:Double x:Key="BpmFontSizeH3">15</sys:Double>
    <sys:Double x:Key="BpmFontSizeBody">13</sys:Double>
    <sys:Double x:Key="BpmFontSizeLabel">12</sys:Double>
    <sys:Double x:Key="BpmFontSizeSmall">11</sys:Double>
    <sys:Double x:Key="BpmFontSizeCaption">10</sys:Double>

    <!-- ── Heading 1: Seitenüberschriften ──────────────────────── -->
    <Style x:Key="BpmHeading1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeH1}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextBright}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- ── Heading 2: Abschnittsüberschriften ──────────────────── -->
    <Style x:Key="BpmHeading2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeH2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextBright}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- ── Heading 3: Gruppenüberschriften, Dialog-Titel ───────── -->
    <Style x:Key="BpmHeading3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeH3}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextBright}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ── Body: Standard-Text ─────────────────────────────────── -->
    <Style x:Key="BpmBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextPrimary}"/>
    </Style>

    <!-- ── Body Bold: Hervorgehobene Werte ─────────────────────── -->
    <Style x:Key="BpmBodyBold" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextPrimary}"/>
    </Style>

    <!-- ── Label: Feld-Labels, Tabs, Sidebar ───────────────────── -->
    <Style x:Key="BpmLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeLabel}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextSecondary}"/>
    </Style>

    <!-- ── Small: Statusleiste, Tooltips ───────────────────────── -->
    <Style x:Key="BpmSmallText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextSecondary}"/>
    </Style>

    <!-- ── Caption: Fußnoten, Version ──────────────────────────── -->
    <Style x:Key="BpmCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeCaption}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource BpmTextSecondary}"/>
    </Style>

    <!-- ── Error-Text: Validierungsfehler ──────────────────────── -->
    <Style x:Key="BpmErrorText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BpmFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource BpmFontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource BpmError}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

</ResourceDictionary>
