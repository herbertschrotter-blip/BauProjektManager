{
  "$comment": "Vorschlag der Art planzuordnung: je Eingangsdatei (kontext.eingangsdateien) Dokumenttyp, Bauteil ODER Kategorie, Geschoss, Plannummer, Index und Bezeichnung; Dateien ohne Zuordnung mit Grund. IDs nur aus kontext.json. Vorschrift: planzuordnung.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["zuordnungen"],
  "properties": {
    "zuordnungen": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datei_id", "dokumenttyp_id", "begruendung"],
        "properties": {
          "datei_id": { "type": "string", "pattern": "^D-\\d{3,5}$" },
          "dokumenttyp_id": { "type": "string", "minLength": 1 },
          "bauteil_id": { "type": ["string", "null"] },
          "kategorie_id": { "type": ["string", "null"] },
          "geschoss_id": { "type": ["string", "null"] },
          "plannummer": { "type": ["string", "null"], "maxLength": 100 },
          "index": { "type": ["string", "null"], "maxLength": 20 },
          "bezeichnung": { "type": ["string", "null"], "maxLength": 200 },
          "index_datum": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "segmente": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["segmenttyp_id", "wert"],
              "properties": {
                "segmenttyp_id": { "type": "string", "minLength": 1 },
                "wert": { "type": "string", "minLength": 1, "maxLength": 100 }
              }
            }
          },
          "tags": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
          "unsicher": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "enum": ["dokumenttyp_id", "bauteil_id", "kategorie_id", "geschoss_id", "plannummer", "index", "bezeichnung",
                       "index_datum", "segmente", "tags"]
            }
          },
          "hinweise": { "type": ["string", "null"], "maxLength": 300 },
          "begruendung": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "nicht_zuordenbar": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datei_id", "grund"],
        "properties": {
          "datei_id": { "type": "string", "pattern": "^D-\\d{3,5}$" },
          "grund": { "type": "string", "maxLength": 300 },
          "fehlt": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["art", "name"],
            "properties": {
              "art": { "enum": ["bauteil", "geschoss", "dokumenttyp"] },
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "beschreibung": { "type": ["string", "null"], "maxLength": 100 },
              "bauteil_id": { "type": ["string", "null"] },
              "geschosse": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
              "unterteilung": { "enum": ["keine", "bauteile", "kategorien", null] }
            }
          }
        }
      }
    },
    "hinweise": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 300 } }
  }
}
