<Window x:Class="BauProjektManager.PlanManager.Views.FolderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BauProjektManager.PlanManager.ViewModels"
        Title="Zielordner wählen"
        Width="420" Height="520"
        MinWidth="340" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BpmBgBase}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BpmBgSurface}" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Zielordner wählen" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource BpmTextBright}"/>
                <TextBlock Text="Der Plan wird journalisiert verschoben — alle Dateien der aktuellen Revision ziehen gemeinsam um."
                           Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource BpmTextSecondary}"/>
            </StackPanel>
        </Border>

        <TreeView Grid.Row="1" x:Name="FolderTree"
                  Style="{DynamicResource BpmTreeView}"
                  ItemContainerStyle="{DynamicResource BpmTreeViewItem}"
                  Margin="8"
                  TreeViewItem.Expanded="OnFolderExpanded"
                  SelectedItemChanged="OnFolderSelected">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerFolderNode}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Border Grid.Row="2" Background="{DynamicResource BpmBgSurface}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Padding="14,5"
                        Style="{DynamicResource BpmButtonSecondary}"
                        Click="OnCancelClick"/>
                <Button x:Name="MoveButton" Content="Verschieben" Padding="14,5" Margin="8,0,0,0"
                        Style="{DynamicResource BpmButtonPrimary}"
                        IsEnabled="False"
                        Click="OnMoveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
