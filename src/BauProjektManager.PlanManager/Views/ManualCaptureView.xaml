<UserControl x:Class="BauProjektManager.PlanManager.Views.ManualCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BauProjektManager.PlanManager.Controls"
             xmlns:views="clr-namespace:BauProjektManager.PlanManager.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- Spalten (Variante B, Teil 47): Tabelle | Splitter | [Detail-Panel + Vorschau-Panel] -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="RightColumn" Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Eingangs-Tabelle (Hold-Geste startet das Radial, siehe Code-Behind) -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                       Foreground="{DynamicResource BpmTextSecondary}"
                       FontSize="{DynamicResource BpmFontSizeCaption}">
                <Run Text="Klick = Auswahl · Strg+Klick = mehrere · "/><Run FontWeight="SemiBold" Text="Halten"/><Run Text=" = Radial zuordnen"/>
            </TextBlock>

            <ListBox x:Name="FileList"
                     ItemsSource="{Binding Rows}"
                     SelectionMode="Extended"
                     Background="{DynamicResource BpmBgBase}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="OnRowPreviewMouseDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBorder"
                                Background="{DynamicResource BpmBgSurface}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Padding="8,6"
                                MinHeight="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           Foreground="{DynamicResource BpmTextBright}"
                                           FontFamily="Consolas"
                                           FontSize="{DynamicResource BpmFontSizeSmall}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SizeText}"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="AssignText"
                                           Text="{Binding CandidateText}"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmInfo}"/>
                                <Setter TargetName="AssignText" Property="Foreground" Value="{DynamicResource BpmInfo}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmError}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmWarning}"/>
                                <Setter TargetName="AssignText" Property="Foreground" Value="{DynamicResource BpmWarning}"/>
                                <Setter TargetName="AssignText" Property="Text" Value="{Binding PendingText}"/>
                            </DataTrigger>
                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BpmBgHover}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Splitter für die Vorschau-Breite (nur sichtbar bei offener Vorschau) -->
        <GridSplitter x:Name="PreviewSplitter"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BpmBorderSubtle}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Visibility="Collapsed"/>

        <!-- Rechte Seite (Variante B): Detail-Panel + einblendbares Vorschau-Panel -->
        <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Detail-Panel (BPM-111.06 Slice A: MVVM Detail-VM + Index-Historie) -->
        <Border Grid.Column="0"
                Background="{DynamicResource BpmBgSurface}"
                BorderBrush="{DynamicResource BpmBorderSubtle}"
                BorderThickness="1,0,0,0"
                Padding="12">
            <DockPanel>
                <!-- Aktionen unten angeheftet -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Grid Margin="0,12,0,8">
                        <TextBlock Text="Pending"
                                   Foreground="{DynamicResource BpmTextSecondary}"
                                   FontSize="{DynamicResource BpmFontSizeSmall}"/>
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{DynamicResource BpmWarning}"
                                   FontSize="{DynamicResource BpmFontSizeSmall}"
                                   Text="{Binding PendingCount}"/>
                    </Grid>

                    <Button Style="{DynamicResource BpmButtonPrimary}"
                            Command="{Binding ConfirmImportCommand}"
                            Margin="0,0,0,6"
                            Content="Import bestätigen"/>
                    <Button Command="{Binding DiscardPendingCommand}"
                            Margin="0,0,0,6"
                            Style="{DynamicResource BpmButtonSecondary}"
                            Content="Pending verwerfen"/>
                    <Button Command="{Binding UndoLastImportCommand}"
                            IsEnabled="{Binding CanUndoLastImport}"
                            Style="{DynamicResource BpmButtonSecondary}"
                            Content="↩ Letzten Import rückgängig"/>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="{DynamicResource BpmFontSizeCaption}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Detail (oben) -->
                <StackPanel>
                    <TextBlock Text="DETAIL-PANEL"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="{DynamicResource BpmFontSizeCaption}"
                               Margin="0,0,0,8"/>

                    <!-- Platzhalter bei keiner / mehrfacher Auswahl -->
                    <TextBlock Text="{Binding DetailPlaceholder}"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="{DynamicResource BpmFontSizeSmall}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Detail einer einzelnen Auswahl -->
                    <ContentControl Content="{Binding SelectedDetail}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{DynamicResource BpmTextBright}"
                                               FontFamily="Consolas"
                                               FontSize="{DynamicResource BpmFontSizeSmall}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Text="Zielordner"
                                               Foreground="{DynamicResource BpmTextSecondary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                    <TextBlock Text="{Binding TargetText}"
                                               Foreground="{DynamicResource BpmTextPrimary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="Plannummer / Index"
                                               Foreground="{DynamicResource BpmTextSecondary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"/>

                                    <!-- Dubletten: nur Anzeige -->
                                    <TextBlock Text="{Binding PlanIndexText}"
                                               Foreground="{DynamicResource BpmTextPrimary}"
                                               FontSize="{DynamicResource BpmFontSizeSmall}"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding IsIdentityReadOnly, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Slice A2: editierbare Identität + Re-Match -->
                                    <StackPanel Margin="0,2,0,8"
                                                Visibility="{Binding CanEditIdentity, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding EditPlanNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{DynamicResource BpmFontSizeSmall}"
                                                     Padding="4,3"
                                                     Background="{DynamicResource BpmBgElevated}"
                                                     Foreground="{DynamicResource BpmTextBright}"
                                                     BorderBrush="{DynamicResource BpmBorderSubtle}"
                                                     CaretBrush="{DynamicResource BpmTextBright}"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding EditIndex, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{DynamicResource BpmFontSizeSmall}"
                                                     Padding="4,3"
                                                     Background="{DynamicResource BpmBgElevated}"
                                                     Foreground="{DynamicResource BpmTextBright}"
                                                     BorderBrush="{DynamicResource BpmBorderSubtle}"
                                                     CaretBrush="{DynamicResource BpmTextBright}"/>
                                        </Grid>
                                        <Button Content="Re-Match anwenden"
                                                Margin="0,6,0,0"
                                                Style="{DynamicResource BpmButtonSecondary}"
                                                Command="{Binding DataContext.ApplyIdentityEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>

                                    <!-- Slice A3: Bezeichnung (nur neue Dokumente — Updates behalten den Bestandstitel) -->
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding CanEditTitle, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Bezeichnung"
                                                   Foreground="{DynamicResource BpmTextSecondary}"
                                                   FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                        <TextBox Text="{Binding Row.Title, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource BpmFontSizeSmall}"
                                                 Padding="4,3"
                                                 Margin="0,2,0,0"
                                                 Background="{DynamicResource BpmBgElevated}"
                                                 Foreground="{DynamicResource BpmTextBright}"
                                                 BorderBrush="{DynamicResource BpmBorderSubtle}"
                                                 CaretBrush="{DynamicResource BpmTextBright}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ReasonText}"
                                               Foreground="{DynamicResource BpmWarning}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Index-Historie (Slice D): immer sichtbar, 3 Spalten, neueste oben -->
                                    <TextBlock Text="{Binding HistoryCaption}"
                                               Foreground="{DynamicResource BpmTextSecondary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,4"/>
                                    <Border Background="{DynamicResource BpmBgElevated}"
                                            CornerRadius="3"
                                            Padding="4"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Revision"
                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                           Margin="4,0,0,0"/>
                                                <TextBlock Grid.Column="1" Text="Datum"
                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                           FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                                <TextBlock Grid.Column="2" Text="Änderung"
                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                           FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding History}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowBg" CornerRadius="2" Padding="4,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="52"/>
                                                                    <ColumnDefinition Width="72"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Index}"
                                                                           Foreground="{DynamicResource BpmTextBright}"
                                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                                           VerticalAlignment="Top"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DateText}"
                                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                                           VerticalAlignment="Top"/>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Change}"
                                                                           Foreground="{DynamicResource BpmTextPrimary}"
                                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                                           TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                <Setter TargetName="RowBg" Property="Background"
                                                                        Value="{DynamicResource BpmBgActive}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="⬆ Update übernehmen"
                                            Style="{DynamicResource BpmButtonPrimary}"
                                            Margin="0,0,0,12"
                                            Visibility="{Binding CanTakeUpdate, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.TakeUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Vorschau-Panel (BPM-111.06 Slice C, Variante B): eingeblendet per Rechtsklick "Vorschau" -->
        <Border x:Name="PreviewHost"
                Grid.Column="1"
                BorderBrush="{DynamicResource BpmBorderSubtle}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <views:PlanPreviewPanel x:Name="PreviewPanel"/>
        </Border>
        </Grid>

        <!-- Radial-Overlay (Gesten-Host steuert Sichtbarkeit + Position) -->
        <Canvas x:Name="OverlayCanvas"
                Grid.ColumnSpan="3"
                Visibility="Collapsed"
                Background="Transparent"
                IsHitTestVisible="False">
            <controls:RadialCaptureControl x:Name="Radial"
                                           Width="460" Height="460"/>
            <Border x:Name="Ghost"
                    Background="{DynamicResource BpmBgActive}"
                    BorderBrush="{DynamicResource BpmAccentPrimary}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="GhostText"
                           Foreground="{DynamicResource BpmTextBright}"
                           FontSize="{DynamicResource BpmFontSizeSmall}"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
