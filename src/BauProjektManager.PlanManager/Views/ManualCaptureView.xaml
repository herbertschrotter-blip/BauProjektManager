<UserControl x:Class="BauProjektManager.PlanManager.Views.ManualCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BauProjektManager.PlanManager.Controls"
             xmlns:views="clr-namespace:BauProjektManager.PlanManager.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- Spalten (Variante B, Teil 47): Tabelle | Detail-Splitter | [Detail-Panel + Vorschau-Panel]
         Beide Panel-Breiten sind per Splitter anpassbar und werden geräte-lokal gemerkt. -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="RightColumn" Width="320"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Chatfenster "Mit Claude sortieren" (Seitenliste 3.4) rechts aussen; DataContext im Code-Behind -->
        <views:ClaudeChatPanel x:Name="ClaudeChat" Grid.Column="3" Width="390" Visibility="Collapsed"
                               BorderBrush="{DynamicResource BpmBorderSubtle}" BorderThickness="1,0,0,0"/>

        <!-- Sub-Tabs Neue Pläne / Archiv (111.07 Slice D) — Styles via Default BpmTabControl/BpmTabItem -->
        <TabControl Grid.Column="0" Margin="0,0,8,0">
        <TabItem Header="{Binding InboxTabHeader}">
        <!-- Eingangs-Tabelle (Hold-Geste startet das Radial, siehe Code-Behind) -->
        <DockPanel Margin="0,8,0,0">
            <!-- Hinweis + Knopf "Mit Claude sortieren" (Seitenliste 3.4); DataContext = ClaudeSortViewModel (Code-Behind) -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid x:Name="ClaudeBar" DockPanel.Dock="Right" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OffHint}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource BpmTextSecondary}"
                                   FontSize="{DynamicResource BpmFontSizeCaption}"/>
                        <Button x:Name="ClaudeButton" Style="{DynamicResource BpmButtonSecondary}"
                                Command="{Binding ToggleStartCommand}"
                                IsEnabled="{Binding IsButtonEnabled}"
                                ToolTip="{Binding ButtonToolTip}"
                                ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" Foreground="{DynamicResource BpmAccentPrimary}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ButtonText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- Startdialog (Zustand 1): was geht an Claude, Plankopf-Haken (ADR-067 E2) -->
                    <Popup IsOpen="{Binding IsConfirmOpen, Mode=OneWay}" PlacementTarget="{Binding ElementName=ClaudeButton}"
                           Placement="Bottom" HorizontalOffset="-220" StaysOpen="True" AllowsTransparency="True">
                        <Border Width="380" Padding="14" CornerRadius="4" Background="{DynamicResource BpmBgSurface}"
                                BorderBrush="{DynamicResource BpmAccentPrimary}" BorderThickness="1"
                                KeyDown="OnClaudeConfirmKeyDown">
                            <StackPanel>
                                <TextBlock Text="Mit Claude sortieren?" Margin="0,0,0,8" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BpmTextBright}" FontSize="{DynamicResource BpmFontSizeBody}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BpmTextPrimary}"
                                           FontSize="{DynamicResource BpmFontSizeSmall}">
                                    <Run Text="Claude bekommt"/>
                                    <Run Text="{Binding ConfirmCountText, Mode=OneWay}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource BpmTextBright}"/>
                                    <Run Text="(Erstaufnahme) und schlägt Zuordnungen vor. Importiert wird erst, wenn du bestätigst."/>
                                </TextBlock>
                                <Border Margin="0,10" Padding="8,6" CornerRadius="3" Background="{DynamicResource BpmBgBase}">
                                    <StackPanel>
                                        <TextBlock FontSize="{DynamicResource BpmFontSizeCaption}" Foreground="{DynamicResource BpmTextPrimary}">
                                            <Run Text="✓" Foreground="{DynamicResource BpmSuccess}"/>
                                            <Run Text="Dateinamen, Größe und Kandidaten aus dem Namen"/>
                                        </TextBlock>
                                        <TextBlock FontSize="{DynamicResource BpmFontSizeCaption}" Foreground="{DynamicResource BpmTextPrimary}">
                                            <Run Text="✓" Foreground="{DynamicResource BpmSuccess}"/>
                                            <Run Text="Dokumenttypen, Bauteile, Kategorien, Geschoße dieses Projekts (IDs)"/>
                                        </TextBlock>
                                        <CheckBox IsChecked="{Binding PlankopfMitsenden}" Margin="0,4,0,2"
                                                  Foreground="{DynamicResource BpmTextPrimary}" FontSize="{DynamicResource BpmFontSizeCaption}"
                                                  Content="Plankopf-Text mitsenden (kann Namen und Adressen von Planern enthalten)"/>
                                        <TextBlock Text="✕ keine Plandateien, keine anderen Projekte" Margin="0,2,0,0"
                                                   FontSize="{DynamicResource BpmFontSizeCaption}" Foreground="{DynamicResource BpmTextSecondary}"/>
                                        <TextBlock Text="{Binding ExcludedText}" FontSize="{DynamicResource BpmFontSizeCaption}"
                                                   Foreground="{DynamicResource BpmTextSecondary}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Läuft über Claude Code auf diesem PC mit deinem Abo (Anthropic)." Margin="0,0,0,10"
                                           TextWrapping="Wrap" FontSize="{DynamicResource BpmFontSizeCaption}"
                                           Foreground="{DynamicResource BpmTextSecondary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Abbrechen" Style="{DynamicResource BpmButtonSecondary}" Margin="0,0,8,0"
                                            Command="{Binding CancelStartCommand}"/>
                                    <Button Content="Starten" Style="{DynamicResource BpmButtonPrimary}"
                                            Command="{Binding StartCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource BpmTextSecondary}"
                           FontSize="{DynamicResource BpmFontSizeCaption}">
                    <Run Text="Klick = Auswahl · Strg+Klick = mehrere · "/><Run FontWeight="SemiBold" Text="Halten"/><Run Text=" = Radial zuordnen"/>
                </TextBlock>
            </DockPanel>

            <!-- Vorschlags-Leiste (Zustand 5): Entwurf geprueft, noch nicht uebernommen -->
            <Border x:Name="ClaudeDraftBar" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="10,6"
                    Background="{DynamicResource BpmBgSurface}" BorderBrush="{DynamicResource BpmAccentPrimary}"
                    BorderThickness="3,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding DraftButtonText}" Style="{DynamicResource BpmButtonPrimary}"
                            Command="{Binding TakeOverCommand}" Margin="8,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="Verwerfen" Style="{DynamicResource BpmButtonSecondary}"
                            Command="{Binding DiscardCommand}"/>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource BpmFontSizeSmall}">
                        <Run Text="✦" Foreground="{DynamicResource BpmAccentPrimary}"/>
                        <Run Text="Entwurf von Claude – bitte prüfen" Foreground="{DynamicResource BpmTextBright}"/>
                        <Run Text="{Binding DraftSummary, Mode=OneWay}" Foreground="{DynamicResource BpmTextSecondary}"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <ListBox x:Name="FileList"
                     ItemsSource="{Binding Rows}"
                     SelectionMode="Extended"
                     Background="{DynamicResource BpmBgBase}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="OnRowPreviewMouseDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBorder"
                                Background="{DynamicResource BpmBgSurface}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Padding="8,6"
                                MinHeight="36"
                                ToolTip="{Binding RowToolTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{DynamicResource BpmTextBright}"
                                               FontFamily="Consolas"
                                               FontSize="{DynamicResource BpmFontSizeSmall}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <!-- 111.07 Slice A: Pill-Badge wie Eingang-Badge der Projektliste -->
                                    <Border Background="{DynamicResource BpmInfo}"
                                            CornerRadius="8" Padding="6,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="⛓ Paar"
                                                   Foreground="{DynamicResource BpmTextBright}"
                                                   FontSize="{DynamicResource BpmFontSizeCaption}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <!-- 111.07 Slice C: Kombi-Plan (kein Auto-Split, V1) -->
                                    <Border Background="{DynamicResource BpmWarning}"
                                            CornerRadius="8" Padding="6,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCombi, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="⚠ Kombi"
                                                   Foreground="{DynamicResource BpmTextBright}"
                                                   FontSize="{DynamicResource BpmFontSizeCaption}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SizeText}"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="AssignText"
                                           Text="{Binding CandidateText}"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmInfo}"/>
                                <Setter TargetName="AssignText" Property="Foreground" Value="{DynamicResource BpmInfo}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmError}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                <Setter TargetName="RowBorder" Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                            <!-- "Mit Claude sortieren": bei Claude / Vorschlag / unsicher / ungueltig (Pending gewinnt, steht danach) -->
                            <DataTrigger Binding="{Binding IsClaudeAtWork}" Value="True">
                                <Setter TargetName="AssignText" Property="Text" Value="{Binding ClaudeMarkText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsClaudeDraft}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmAccentPrimary}"/>
                                <Setter TargetName="AssignText" Property="Foreground" Value="{DynamicResource BpmAccentPrimary}"/>
                                <Setter TargetName="AssignText" Property="Text" Value="{Binding ClaudeMarkText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsClaudeInvalid}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmError}"/>
                                <Setter TargetName="AssignText" Property="Foreground" Value="{DynamicResource BpmError}"/>
                                <Setter TargetName="AssignText" Property="Text" Value="{Binding ClaudeMarkText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BpmWarning}"/>
                                <Setter TargetName="AssignText" Property="Foreground" Value="{DynamicResource BpmWarning}"/>
                                <Setter TargetName="AssignText" Property="Text" Value="{Binding PendingText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsClaudeUncertain}" Value="True">
                                <Setter TargetName="AssignText" Property="FontStyle" Value="Italic"/>
                            </DataTrigger>
                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BpmBgHover}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </TabItem>

        <!-- Archiv-Tab (111.07 Slice D): Bestand aus der DB, grün = letzter Import -->
        <TabItem Header="{Binding ArchiveTabHeader}">
        <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6"
                       Foreground="{DynamicResource BpmTextSecondary}"
                       FontSize="{DynamicResource BpmFontSizeCaption}">
                <Run Text="Alle importierten Dokumente · "/><Run FontWeight="SemiBold" Foreground="{DynamicResource BpmSuccess}" Text="grün"/><Run Text=" = letzter Import (↩ macht ihn komplett rückgängig)"/>
            </TextBlock>

            <ListBox x:Name="ArchiveList"
                     ItemsSource="{Binding ArchiveRows}"
                     SelectionMode="Single"
                     Background="{DynamicResource BpmBgBase}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseRightButtonUp="OnArchiveRowContextMenu"
                     PreviewMouseLeftButtonDown="OnArchiveRowPreviewMouseDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ArcRowBorder"
                                Background="{DynamicResource BpmBgSurface}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                Padding="8,6"
                                MinHeight="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="84"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           Foreground="{DynamicResource BpmTextBright}"
                                           FontFamily="Consolas"
                                           FontSize="{DynamicResource BpmFontSizeSmall}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DirectoryText}"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="ArcDate"
                                           Text="{Binding DateText}"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="3"
                                        Content="↩"
                                        Style="{DynamicResource BpmButtonSecondary}"
                                        Padding="4,0" Height="24" MinWidth="30"
                                        IsEnabled="{Binding CanUndo}"
                                        ToolTip="Macht den LETZTEN Import komplett rückgängig (Undo nur letzter Import)"
                                        Command="{Binding DataContext.UndoLastImportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLastImport}" Value="True">
                                <Setter TargetName="ArcRowBorder" Property="BorderBrush" Value="{DynamicResource BpmSuccess}"/>
                                <Setter TargetName="ArcDate" Property="Foreground" Value="{DynamicResource BpmSuccess}"/>
                            </DataTrigger>
                            <Trigger SourceName="ArcRowBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArcRowBorder" Property="Background" Value="{DynamicResource BpmBgHover}"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </TabItem>
        </TabControl>

        <!-- Splitter für die Detail-Panel-Breite (immer sichtbar) -->
        <GridSplitter x:Name="DetailSplitter"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BpmBorderSubtle}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <!-- Rechte Seite (Variante B): Detail-Panel (dehnt sich) + einblendbares Vorschau-Panel -->
        <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="PreviewColumnInner" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Detail-Panel (BPM-111.06 Slice A: MVVM Detail-VM + Index-Historie) -->
        <Border Grid.Column="0"
                Background="{DynamicResource BpmBgSurface}"
                BorderBrush="{DynamicResource BpmBorderSubtle}"
                BorderThickness="1,0,0,0"
                Padding="12">
            <DockPanel>
                <!-- Aktionen unten angeheftet -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Grid Margin="0,12,0,8">
                        <TextBlock Text="Pending"
                                   Foreground="{DynamicResource BpmTextSecondary}"
                                   FontSize="{DynamicResource BpmFontSizeSmall}"/>
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{DynamicResource BpmWarning}"
                                   FontSize="{DynamicResource BpmFontSizeSmall}"
                                   Text="{Binding PendingCount}"/>
                    </Grid>

                    <Button Style="{DynamicResource BpmButtonPrimary}"
                            Command="{Binding ConfirmImportCommand}"
                            Margin="0,0,0,6"
                            MaxWidth="296" MinWidth="296" HorizontalAlignment="Left"
                            Content="Import bestätigen"/>
                    <Button Command="{Binding DiscardPendingCommand}"
                            Margin="0,0,0,6"
                            Style="{DynamicResource BpmButtonSecondary}"
                            MaxWidth="296" MinWidth="296" HorizontalAlignment="Left"
                            Content="Pending verwerfen"/>
                    <Button Command="{Binding UndoLastImportCommand}"
                            IsEnabled="{Binding CanUndoLastImport}"
                            Style="{DynamicResource BpmButtonSecondary}"
                            MaxWidth="296" MinWidth="296" HorizontalAlignment="Left"
                            Content="↩ Letzten Import rückgängig"/>
                    <TextBlock Text="{Binding UndoHint}"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="{DynamicResource BpmFontSizeCaption}"
                               TextWrapping="Wrap" MaxWidth="296" HorizontalAlignment="Left"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UndoHint}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="{DynamicResource BpmFontSizeCaption}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Detail (oben) -->
                <StackPanel>
                    <TextBlock Text="DETAIL-PANEL"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="{DynamicResource BpmFontSizeCaption}"
                               Margin="0,0,0,8"/>

                    <!-- Platzhalter bei keiner / mehrfacher Auswahl -->
                    <TextBlock Text="{Binding DetailPlaceholder}"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="{DynamicResource BpmFontSizeSmall}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Detail einer einzelnen Auswahl -->
                    <ContentControl Content="{Binding SelectedDetail}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               Foreground="{DynamicResource BpmTextBright}"
                                               FontFamily="Consolas"
                                               FontSize="{DynamicResource BpmFontSizeSmall}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <!-- "Mit Claude sortieren" (Seitenliste 3.4): Vorschlag, Begruendung, unsichere Felder,
                                         Einzel-Annahme/Ablehnung solange der Entwurf offen ist -->
                                    <Border Margin="0,0,0,10" Padding="8,6" Background="{DynamicResource BpmBgBase}"
                                            BorderBrush="{DynamicResource BpmAccentPrimary}" BorderThickness="3,0,0,0"
                                            Visibility="{Binding Row.HasClaudeInfo, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Row.ClaudeInfoTitle}" Margin="0,0,0,4"
                                                       Foreground="{DynamicResource BpmAccentPrimary}"
                                                       FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                            <TextBlock Text="{Binding Row.ClaudeMarkText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BpmTextBright}"
                                                       FontSize="{DynamicResource BpmFontSizeSmall}"
                                                       Visibility="{Binding Row.IsClaudeDraft, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding Row.ClaudeInfo.Reason}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource BpmTextPrimary}"
                                                       FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                            <TextBlock Text="{Binding Row.ClaudeUncertainText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource BpmWarning}"
                                                       FontSize="{DynamicResource BpmFontSizeCaption}"
                                                       Visibility="{Binding Row.IsClaudeUncertain, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding Row.IsClaudeDraft, Converter={StaticResource BoolToVis}}">
                                                <Button Content="Nur diesen übernehmen" Style="{DynamicResource BpmButtonSecondary}"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ClaudeSort.TakeOverOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Row.RelativePath}"/>
                                                <Button Content="Ablehnen" Style="{DynamicResource BpmButtonSecondary}"
                                                        Command="{Binding DataContext.ClaudeSort.RejectOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Row.RelativePath}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Zielordner"
                                               Foreground="{DynamicResource BpmTextSecondary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                    <TextBlock Text="{Binding TargetText}"
                                               Foreground="{DynamicResource BpmTextPrimary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="Plannummer / Index"
                                               Foreground="{DynamicResource BpmTextSecondary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"/>

                                    <!-- Dubletten: nur Anzeige -->
                                    <TextBlock Text="{Binding PlanIndexText}"
                                               Foreground="{DynamicResource BpmTextPrimary}"
                                               FontSize="{DynamicResource BpmFontSizeSmall}"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding IsIdentityReadOnly, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Slice A2: editierbare Identität + Re-Match -->
                                    <StackPanel Margin="0,2,0,8"
                                                Visibility="{Binding CanEditIdentity, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding EditPlanNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{DynamicResource BpmFontSizeSmall}"
                                                     Padding="4,3"
                                                     Background="{DynamicResource BpmBgElevated}"
                                                     Foreground="{DynamicResource BpmTextBright}"
                                                     BorderBrush="{DynamicResource BpmBorderSubtle}"
                                                     CaretBrush="{DynamicResource BpmTextBright}"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding EditIndex, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{DynamicResource BpmFontSizeSmall}"
                                                     Padding="4,3"
                                                     Background="{DynamicResource BpmBgElevated}"
                                                     Foreground="{DynamicResource BpmTextBright}"
                                                     BorderBrush="{DynamicResource BpmBorderSubtle}"
                                                     CaretBrush="{DynamicResource BpmTextBright}"/>
                                        </Grid>
                                        <Button Content="Re-Match anwenden"
                                                Margin="0,6,0,0"
                                                MaxWidth="296" MinWidth="296" HorizontalAlignment="Left"
                                                Style="{DynamicResource BpmButtonSecondary}"
                                                Command="{Binding DataContext.ApplyIdentityEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>

                                    <!-- Slice A3: Bezeichnung (nur neue Dokumente — Updates behalten den Bestandstitel) -->
                                    <StackPanel Margin="0,0,0,8"
                                                Visibility="{Binding CanEditTitle, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Bezeichnung"
                                                   Foreground="{DynamicResource BpmTextSecondary}"
                                                   FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                        <TextBox Text="{Binding Row.Title, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource BpmFontSizeSmall}"
                                                 Padding="4,3"
                                                 Margin="0,2,0,0"
                                                 Background="{DynamicResource BpmBgElevated}"
                                                 Foreground="{DynamicResource BpmTextBright}"
                                                 BorderBrush="{DynamicResource BpmBorderSubtle}"
                                                 CaretBrush="{DynamicResource BpmTextBright}"/>
                                    </StackPanel>

                                    <!-- 111.07 Slice A: Paar-Hinweis (eine Revision, zwei Dateien) -->
                                    <Border Background="{DynamicResource BpmBgActive}"
                                            BorderBrush="{DynamicResource BpmInfo}"
                                            BorderThickness="3,0,0,0"
                                            Padding="8,6"
                                            Margin="0,0,0,10"
                                            Visibility="{Binding Row.IsPaired, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource BpmFontSizeCaption}"
                                                       Foreground="{DynamicResource BpmTextBright}"
                                                       TextWrapping="Wrap">
                                                <Run Text="⛓ Gepaart mit "/><Run FontFamily="Consolas" Text="{Binding Row.PairedFileName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="{DynamicResource BpmFontSizeCaption}"
                                                       Foreground="{DynamicResource BpmTextSecondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Text="Import als EINE Revision mit zwei Dateien (PDF führend, DWG angehängt)"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 111.07 Slice C: Kombi-Warnhinweis (kein Auto-Split in V1) -->
                                    <Border Background="{DynamicResource BpmBgElevated}"
                                            BorderBrush="{DynamicResource BpmWarning}"
                                            BorderThickness="3,0,0,0"
                                            Padding="8,6"
                                            Margin="0,0,0,10"
                                            Visibility="{Binding Row.IsCombi, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock FontSize="{DynamicResource BpmFontSizeCaption}"
                                                       Foreground="{DynamicResource BpmWarning}"
                                                       TextWrapping="Wrap"
                                                       Text="⚠ Kombi-Plan erkannt (mehrere Plantypen im Namen)"/>
                                            <TextBlock FontSize="{DynamicResource BpmFontSizeCaption}"
                                                       Foreground="{DynamicResource BpmTextSecondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Text="V1: kein Auto-Split — als EIN Dokument erfassen, Typ „Kombiplan/Sonstiges“ empfohlen (+ Neu…); Inhalte per Text-Zuweisung als Segmente."/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding ReasonText}"
                                               Foreground="{DynamicResource BpmWarning}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Index-Historie (Slice D): immer sichtbar, 3 Spalten, neueste oben -->
                                    <TextBlock Text="{Binding HistoryCaption}"
                                               Foreground="{DynamicResource BpmTextSecondary}"
                                               FontSize="{DynamicResource BpmFontSizeCaption}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,4"/>
                                    <Border Background="{DynamicResource BpmBgElevated}"
                                            CornerRadius="3"
                                            Padding="4"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Revision"
                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                           Margin="4,0,0,0"/>
                                                <TextBlock Grid.Column="1" Text="Datum"
                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                           FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                                <TextBlock Grid.Column="2" Text="Änderung"
                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                           FontSize="{DynamicResource BpmFontSizeCaption}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding History}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="RowBg" CornerRadius="2" Padding="4,3">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="52"/>
                                                                    <ColumnDefinition Width="72"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Index}"
                                                                           Foreground="{DynamicResource BpmTextBright}"
                                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                                           VerticalAlignment="Top"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DateText}"
                                                                           Foreground="{DynamicResource BpmTextSecondary}"
                                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                                           VerticalAlignment="Top"/>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Change}"
                                                                           Foreground="{DynamicResource BpmTextPrimary}"
                                                                           FontSize="{DynamicResource BpmFontSizeCaption}"
                                                                           TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                <Setter TargetName="RowBg" Property="Background"
                                                                        Value="{DynamicResource BpmBgActive}"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="{Binding TakeUpdateLabel}"
                                            Style="{DynamicResource BpmButtonPrimary}"
                                            Margin="0,0,0,12"
                                            MaxWidth="296" MinWidth="296" HorizontalAlignment="Left"
                                            Visibility="{Binding CanTakeUpdate, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.TakeUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Splitter für die Vorschau-Breite (nur sichtbar bei offener Vorschau) -->
        <GridSplitter x:Name="PreviewSplitter"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BpmBorderSubtle}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Visibility="Collapsed"/>

        <!-- Vorschau-Panel (BPM-111.06 Slice C, Variante B): eingeblendet per Rechtsklick "Vorschau" -->
        <Border x:Name="PreviewHost"
                Grid.Column="2"
                BorderBrush="{DynamicResource BpmBorderSubtle}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <views:PlanPreviewPanel x:Name="PreviewPanel"/>
        </Border>
        </Grid>

        <!-- Radial-Overlay (Gesten-Host steuert Sichtbarkeit + Position) -->
        <Canvas x:Name="OverlayCanvas"
                Grid.ColumnSpan="4"
                Visibility="Collapsed"
                Background="Transparent"
                IsHitTestVisible="False">
            <controls:RadialCaptureControl x:Name="Radial"
                                           Width="460" Height="460"/>
            <Border x:Name="Ghost"
                    Background="{DynamicResource BpmBgActive}"
                    BorderBrush="{DynamicResource BpmAccentPrimary}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,4"
                    IsHitTestVisible="False">
                <TextBlock x:Name="GhostText"
                           Foreground="{DynamicResource BpmTextBright}"
                           FontSize="{DynamicResource BpmFontSizeSmall}"/>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
