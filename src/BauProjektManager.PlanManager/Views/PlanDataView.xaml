<UserControl x:Class="BauProjektManager.PlanManager.Views.PlanDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: Suche + Filter (Excel-Export folgt mit Slice d) -->
        <Border Grid.Row="0" Background="{DynamicResource BpmBgSurface}"
                BorderBrush="{DynamicResource BpmBorderSubtle}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Suche"
                           Foreground="{DynamicResource BpmTextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox DockPanel.Dock="Left" Width="220"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Background="{DynamicResource BpmBgInput}"
                         Foreground="{DynamicResource BpmTextPrimary}"
                         BorderBrush="{DynamicResource BpmBorderDefault}"
                         BorderThickness="1" Padding="6,3" FontSize="11"
                         ToolTip="Sucht in Plannummer, Bezeichnung, Typ und Änderungshinweis"/>

                <TextBlock DockPanel.Dock="Left" Text="Typ"
                           Foreground="{DynamicResource BpmTextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox DockPanel.Dock="Left" Width="150"
                          ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          FontSize="11"/>

                <TextBlock DockPanel.Dock="Left" Text="Bauteil"
                           Foreground="{DynamicResource BpmTextSecondary}"
                           FontSize="11" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox DockPanel.Dock="Left" Width="110"
                          ItemsSource="{Binding PartFilters}"
                          SelectedItem="{Binding SelectedPartFilter}"
                          FontSize="11"/>

                <Button DockPanel.Dock="Right" Content="⟳" Width="26" Padding="0,2"
                        Style="{DynamicResource BpmButtonGhost}"
                        ToolTip="Neu laden"
                        Command="{Binding LoadCommand}"/>
                <TextBlock/>
            </DockPanel>
        </Border>

        <!-- Plandaten-Tabelle (read-only) -->
        <DataGrid Grid.Row="1" x:Name="PlanGrid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow}"
                  Style="{DynamicResource BpmDataGridZebra}"
                  ColumnHeaderStyle="{DynamicResource BpmDataGridColumnHeader}"
                  RowStyle="{DynamicResource BpmDataGridRow}"
                  CellStyle="{DynamicResource BpmDataGridCell}"
                  BorderThickness="0"
                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Plan-Nr" Binding="{Binding PlanNumber}" Width="100"/>
                <DataGridTextColumn Header="Idx" Binding="{Binding PlanIndex}" Width="45"/>
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Typ" Binding="{Binding DocumentType}" Width="115"/>
                <DataGridTextColumn Header="Bauteil" Binding="{Binding BuildingPart}" Width="70"/>
                <DataGridTextColumn Header="Geschoss" Binding="{Binding BuildingLevel}" Width="80"/>
                <DataGridTextColumn Header="Index-Datum" Binding="{Binding ReleasedAt}" Width="95"/>
                <DataGridTextColumn Header="Änderungshinweis" Binding="{Binding ChangeNote}" Width="200"/>
                <DataGridTextColumn Header="Dateien" Binding="{Binding FileTypes}" Width="90"/>
                <DataGridTextColumn Header="Segmente" Binding="{Binding SegmentText}" Width="95"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty-State -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="Keine Plandaten"
                       Foreground="{DynamicResource BpmTextSecondary}"
                       FontSize="14" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource BpmTextSecondary}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Statuszeile -->
        <Border Grid.Row="2" Background="{DynamicResource BpmBgSurface}"
                BorderBrush="{DynamicResource BpmBorderSubtle}" BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="Read-only · Änderungen über Import-/Archiv-Workflows"
                           Foreground="{DynamicResource BpmTextSecondary}" FontSize="11"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource BpmTextSecondary}" FontSize="11"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
