<Window x:Class="BauProjektManager.PlanManager.Views.ProfileWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BauProjektManager.PlanManager.Views"
        Title="{Binding DialogTitle}"
        Width="780" Height="600"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BpmBgElevated}"
        Foreground="{DynamicResource BpmTextPrimary}">
    <!-- Profil-Wizard (Seitenliste 3.8, Mockup 0.2, BPM-130): 4 Schritte, Erkennung haengt am Dokumenttyp -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="WizHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BpmTextSecondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource BpmFontSizeSmall}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="WizLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BpmTextSecondary}"/>
            <Setter Property="FontSize" Value="{DynamicResource BpmFontSizeLabel}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="WizNote" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BpmBgSurface}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf: Schritt-Titel + 4 Punkte -->
        <Border Grid.Row="0" Background="{DynamicResource BpmBgSurface}" Padding="16,12">
            <StackPanel>
                <TextBlock FontSize="{DynamicResource BpmFontSizeBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource BpmTextBright}" Text="{Binding StepTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Ellipse x:Name="Dot1" Width="10" Height="10" Margin="0,0,6,0"/>
                    <Ellipse x:Name="Dot2" Width="10" Height="10" Margin="0,0,6,0"/>
                    <Ellipse x:Name="Dot3" Width="10" Height="10" Margin="0,0,6,0"/>
                    <Ellipse x:Name="Dot4" Width="10" Height="10"/>
                    <TextBlock x:Name="StepCounter" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource BpmTextSecondary}" FontSize="{DynamicResource BpmFontSizeSmall}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- === SCHRITT 1: Dokumenttyp + Beispieldatei === -->
            <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Dokumenttyp" Style="{StaticResource WizLabel}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DocumentTypeOptions}" SelectedItem="{Binding SelectedDocumentType}"
                              DisplayMemberPath="Name" Width="360" HorizontalAlignment="Left"
                              Style="{DynamicResource BpmComboBox}"/>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource WizHint}"
                               Text="Die Erkennung gehört zum Dokumenttyp – der Name und der Ablageordner kommen von dort."/>
                    <Border Style="{StaticResource WizNote}" BorderBrush="{DynamicResource BpmWarning}"
                            Visibility="{Binding ExistingProfileNote, Converter={x:Static views:ProfileWizardDialog.TextToVis}}">
                        <TextBlock Text="{Binding ExistingProfileNote}" TextWrapping="Wrap" FontSize="{DynamicResource BpmFontSizeLabel}"/>
                    </Border>

                    <TextBlock Text="Beispieldatei aus dem Eingang" Style="{StaticResource WizLabel}" Margin="0,16,0,4"/>
                    <ListBox ItemsSource="{Binding InboxFiles}" SelectedItem="{Binding SelectedInboxFile}"
                             MaxHeight="200" FontFamily="Consolas" FontSize="{DynamicResource BpmFontSizeLabel}"
                             Background="{DynamicResource BpmBgBase}" Foreground="{DynamicResource BpmTextPrimary}"
                             BorderBrush="{DynamicResource BpmBorderDefault}"
                             Visibility="{Binding HasInboxFiles, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource WizHint}" Text="Oder "/>
                        <TextBlock Text="andere Datei wählen …" Cursor="Hand" FontSize="{DynamicResource BpmFontSizeSmall}"
                                   Foreground="{DynamicResource BpmAccentPrimary}" MouseLeftButtonUp="OnPickFileClick"/>
                        <TextBlock Style="{StaticResource WizHint}" Text=" · Endung und Kopiermarker werden nicht zerlegt."/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontFamily="Consolas" FontSize="{DynamicResource BpmFontSizeLabel}"
                               Foreground="{DynamicResource BpmTextBright}" Text="{Binding SampleFileName}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- === SCHRITT 2: Segmente (Segment-Editor, BPM-126c) === -->
            <ScrollViewer x:Name="Step2Panel" VerticalScrollBarVisibility="Auto" Padding="20,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontFamily="Consolas" FontSize="{DynamicResource BpmFontSizeSmall}" Margin="0,0,0,8"
                               Foreground="{DynamicResource BpmTextSecondary}" Text="{Binding SampleFileName}"/>
                    <views:SegmentEditorControl x:Name="SegmentEditor"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource WizHint}"
                               Visibility="{Binding CopyMarker, Converter={x:Static views:ProfileWizardDialog.TextToVis}}">
                        <Run Text="Kopiermarker"/> <Run Text="{Binding CopyMarker, Mode=OneWay}" FontFamily="Consolas"/>
                        <Run Text="wird ignoriert – er ist nie ein Segment."/>
                    </TextBlock>
                    <Border x:Name="Step2Note" Style="{StaticResource WizNote}">
                        <StackPanel>
                            <TextBlock Text="{Binding Step2Message}" TextWrapping="Wrap" FontSize="{DynamicResource BpmFontSizeLabel}"/>
                            <TextBlock Text="Alle offenen auf „Ignorieren“" Cursor="Hand" Margin="0,4,0,0"
                                       FontSize="{DynamicResource BpmFontSizeLabel}" Foreground="{DynamicResource BpmAccentPrimary}"
                                       Visibility="{Binding CanIgnoreOpen, Converter={StaticResource BoolToVis}}"
                                       MouseLeftButtonUp="OnIgnoreOpenClick"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === SCHRITT 3: Index === -->
            <ScrollViewer x:Name="Step3Panel" VerticalScrollBarVisibility="Auto" Padding="20,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Wo steht der Index?" Style="{StaticResource WizLabel}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding IndexSourceOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <RadioButton GroupName="IndexSource" Checked="OnIndexSourceChecked" Loaded="OnIndexSourceLoaded"
                                                 Foreground="{DynamicResource BpmTextPrimary}" FontSize="{DynamicResource BpmFontSizeBody}">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </RadioButton>
                                    <TextBlock Text="{Binding Description}" Margin="20,2,0,0" Style="{StaticResource WizHint}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource WizNote}" BorderBrush="{DynamicResource BpmWarning}"
                            Visibility="{Binding ShowIndexWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource BpmFontSizeLabel}"
                                   Text="In der Beispieldatei ist kein Index-Segment zugewiesen. Das ist erlaubt – weiter geht es trotzdem."/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === SCHRITT 4: Erkennung === -->
            <ScrollViewer x:Name="Step4Panel" VerticalScrollBarVisibility="Auto" Padding="20,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource WizHint}" Margin="0,0,0,8"
                               Text="Welche Teile zeigen, dass es dieser Dokumenttyp ist? Anklicken (mehrere möglich)."/>
                    <ItemsControl ItemsSource="{Binding RecognitionSegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsSelected}" Click="OnRecognitionSegmentClick"
                                              Content="{Binding RawValue}" Margin="0,0,6,6" Padding="10,6" Cursor="Hand"
                                              FontFamily="Consolas" FontSize="{DynamicResource BpmFontSizeBody}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                                    Background="{DynamicResource BpmBgSurface}" BorderBrush="{DynamicResource BpmBorderDefault}">
                                                <ContentPresenter x:Name="Cp" TextElement.Foreground="{DynamicResource BpmTextSecondary}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BpmAccentPrimary}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BpmAccentPrimary}"/>
                                                    <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource BpmTextBright}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource WizNote}" BorderBrush="{DynamicResource BpmSuccess}"
                            Visibility="{Binding RecognitionPattern, Converter={x:Static views:ProfileWizardDialog.TextToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding RecognitionPattern}" TextWrapping="Wrap" FontSize="{DynamicResource BpmFontSizeLabel}"/>
                            <TextBlock Text="{Binding PatternTestResult}" Margin="0,4,0,0" Style="{StaticResource WizHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WizNote}" BorderBrush="{DynamicResource BpmWarning}"
                            Visibility="{Binding RecognitionWarning, Converter={x:Static views:ProfileWizardDialog.TextToVis}}">
                        <TextBlock Text="{Binding RecognitionWarning}" TextWrapping="Wrap" FontSize="{DynamicResource BpmFontSizeLabel}"/>
                    </Border>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource WizHint}"
                               Text="Gespeichert wird am Dokumenttyp. Gibt es dort schon eine Erkennung, wird sie ersetzt."/>
                    <TextBlock Margin="0,8,0,0" Text="{Binding SaveError}" TextWrapping="Wrap"
                               Foreground="{DynamicResource BpmError}" FontSize="{DynamicResource BpmFontSizeLabel}"
                               Visibility="{Binding SaveError, Converter={x:Static views:ProfileWizardDialog.TextToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Fuss -->
        <Border Grid.Row="2" Background="{DynamicResource BpmBgSurface}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Abbrechen" Style="{DynamicResource BpmButtonSecondary}" Click="OnCancel"/>
                <Button Grid.Column="1" Content="Zurück" Style="{DynamicResource BpmButtonSecondary}"
                        HorizontalAlignment="Right" Margin="0,0,8,0" IsEnabled="{Binding CanGoBack}" Click="OnBack"/>
                <Button x:Name="NextButton" Grid.Column="2" Content="Weiter" Style="{DynamicResource BpmButtonPrimary}"
                        IsEnabled="{Binding CanGoNext}" Click="OnNext"/>
            </Grid>
        </Border>
    </Grid>
</Window>
