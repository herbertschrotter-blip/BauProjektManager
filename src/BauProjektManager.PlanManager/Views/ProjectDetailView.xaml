<UserControl x:Class="BauProjektManager.PlanManager.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BauProjektManager.PlanManager.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: ← Zurück + Projektname (BPM-120 H0: "Import starten" entfernt —
             der Radial-/Bucket-Workflow im Tab "Manuell sortieren" ist der einzige
             V1-Importweg, ADR-064 P.9) -->
        <Border Grid.Row="0" Background="{DynamicResource BpmBgSurface}"
                Padding="8,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Zurück"
                        Style="{DynamicResource BpmButtonGhost}"
                        Command="{Binding GoBackCommand}"
                        Foreground="{DynamicResource BpmTextSecondary}"
                        VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Project.Name}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource BpmTextBright}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Eingang-Banner (nur wenn Dateien im Eingang) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BpmWarning}"
                Padding="10,6" Margin="0,0,0,8"
                CornerRadius="3"
                Visibility="{Binding HasInbox, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding InboxInfo}"
                       Foreground="{DynamicResource BpmTextBright}"
                       FontSize="12" FontWeight="SemiBold"/>
        </Border>

        <!-- 5 Tabs (Style via Default aus Dialogs.xaml: BpmTabControl + BpmTabItem).
             Reihenfolge Teil 50: Explorer (Start-Tab) · Manuell sortieren · Plandaten ·
             Profile · Sync. -->
        <TabControl Grid.Row="2"
                    x:Name="DetailTabs"
                    SelectionChanged="OnTabChanged"
                    Foreground="{DynamicResource BpmTextPrimary}">

            <!-- Tab 1: Explorer (BPM-112.06a — Live-FS-Ansicht, ADR-061 P.6 Modell A) -->
            <TabItem Header="Explorer">
                <views:ExplorerView x:Name="ExplorerHost" Margin="0,12,0,0"/>
            </TabItem>

            <!-- Tab 2: Manuell sortieren (BPM-111.05: Radial-Erfassung, lazy beim ersten Öffnen) -->
            <TabItem Header="Manuell sortieren" x:Name="ManualSortTab">
                <ContentControl x:Name="ManualSortHost" Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Manueller Sortier-Modus"
                                   Foreground="{DynamicResource BpmTextSecondary}"
                                   FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Projektpfad nicht gesetzt — bitte zuerst in den Einstellungen hinterlegen."
                                   Foreground="{DynamicResource BpmTextSecondary}"
                                   FontSize="11" HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </ContentControl>
            </TabItem>

            <!-- Tab 3: Plandaten (BPM-126 — DB-Sicht auf den kuratierten Planindex) -->
            <TabItem Header="Plandaten">
                <views:PlanDataView x:Name="PlanDataHost" Margin="0,12,0,0"/>
            </TabItem>

            <!-- Tab 4: Profile -->
            <TabItem Header="Profile">
                <Grid Margin="0,12,0,0">
                    <Button Content="+ Neuer Dokumenttyp"
                            Style="{DynamicResource BpmButtonSecondary}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Click="OnNewProfile"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Noch keine Profile angelegt."
                                   Foreground="{DynamicResource BpmTextSecondary}"
                                   FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="Klicke + Neuer Dokumenttyp um einen Dateinamen anzulernen."
                                   Foreground="{DynamicResource BpmTextSecondary}"
                                   FontSize="11" HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 5: Sync -->
            <TabItem Header="Sync">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Ordner-Sync"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock Text="Firmenserver ↔ OneDrive Sync. (Post-V1, BACKLOG #35)"
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="11" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
