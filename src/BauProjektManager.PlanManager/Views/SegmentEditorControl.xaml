<UserControl x:Class="BauProjektManager.PlanManager.Views.SegmentEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BauProjektManager.PlanManager.Views">
    <UserControl.Resources>
        <views:SegmentColorConverter x:Key="SegColor"/>
    </UserControl.Resources>
    <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}">

        <!-- Kopfzeile: Hinweis + Link auf den bestehenden Segmenttyp-Manager -->
        <DockPanel Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Right"
                       Text="⚙ Segmenttypen verwalten…"
                       Foreground="{DynamicResource BpmAccentPrimary}"
                       FontSize="11" Cursor="Hand"
                       MouseLeftButtonUp="OnManageTypesClick"/>
            <TextBlock Text="Trennzeichen klicken = teilen/verbinden · Segmenttyp auf eine Fläche ziehen"
                       Foreground="{DynamicResource BpmTextSecondary}" FontSize="10"/>
        </DockPanel>

        <!-- EINE kombinierte Fläche: Token-Kacheln mit klickbaren Trennern dazwischen -->
        <Border Background="{DynamicResource BpmBgBase}"
                BorderBrush="{DynamicResource BpmBorderSubtle}" BorderThickness="1"
                CornerRadius="3" Padding="8,6">
            <DockPanel>
                <!-- Globale Trenner-Chips -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trenner:" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource BpmTextSecondary}" Margin="8,0,4,0"/>
                    <ItemsControl ItemsSource="{Binding SeparatorChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" Padding="6,1" Margin="2,0" Cursor="Hand"
                                        BorderThickness="1"
                                        MouseLeftButtonUp="OnSeparatorChipClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BpmBgElevated}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BpmBorderDefault}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BpmBgActive}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BpmAccentPrimary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontFamily="Consolas"
                                               Foreground="{DynamicResource BpmTextPrimary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Token + Trenner in einer Zeile -->
                <ItemsControl ItemsSource="{Binding Elements}" DockPanel.Dock="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Trennzeichen (klickbar) -->
                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                           FontWeight="SemiBold" Cursor="Hand" Padding="3,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource BpmAccentPrimary}"
                                           ToolTip="Klick: dieses Trennzeichen deaktivieren (Nachbarn verschmelzen)"
                                           MouseLeftButtonUp="OnSeparatorClick"
                                           Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}"/>

                                <!-- Token-Kachel (Drop-Ziel) -->
                                <Border Padding="8,3" Margin="1,0" CornerRadius="3" MinWidth="42"
                                        AllowDrop="True" Cursor="Hand"
                                        Drop="OnTokenDrop" DragOver="OnTokenDragOver"
                                        MouseRightButtonUp="OnTokenClearClick"
                                        ToolTip="Segmenttyp hierher ziehen · Rechtsklick entfernt die Zuweisung"
                                        Visibility="{Binding IsToken, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource BpmBgElevated}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BpmTextSecondary}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssigned}" Value="True">
                                                    <Setter Property="Background" Value="{Binding ColorHex, Converter={StaticResource SegColor}}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Text-Bausteine: verschmolzene Trennzeichen bleiben klickbar -->
                                        <ItemsControl ItemsSource="{Binding Parts}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BpmTextBright}"
                                                                   Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                                                   FontWeight="SemiBold" Cursor="Hand" Opacity="0.75"
                                                                   Foreground="{DynamicResource BpmTextBright}"
                                                                   TextDecorations="Underline"
                                                                   ToolTip="Klick: hier wieder trennen"
                                                                   MouseLeftButtonUp="OnMergedSeparatorClick"
                                                                   Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="9"
                                                   HorizontalAlignment="Center" Opacity="0.85"
                                                   Foreground="{DynamicResource BpmTextPrimary}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Dateiendung: gehoert NICHT zu den Segmenten (Format, kein Inhalt) -->
                <TextBlock Text="{Binding Extension}" FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center" Margin="2,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource BpmTextSecondary}"
                           ToolTip="Dateiendung — wird nicht als Segment zugewiesen"/>
            </DockPanel>
        </Border>

        <!-- Palette: Segmenttypen als Drag-Quellen -->
        <ItemsControl ItemsSource="{Binding Palette}" Margin="0,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BpmBgElevated}"
                            BorderBrush="{DynamicResource BpmBorderDefault}" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,4,4" Cursor="Hand"
                            ToolTip="Auf eine Segment-Fläche ziehen"
                            PreviewMouseLeftButtonDown="OnPaletteDragStart">
                        <TextBlock Text="{Binding Name}" FontSize="11"
                                   Foreground="{DynamicResource BpmTextPrimary}"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
