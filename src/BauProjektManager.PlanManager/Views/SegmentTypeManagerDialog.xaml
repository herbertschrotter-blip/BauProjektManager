<Window x:Class="BauProjektManager.PlanManager.Views.SegmentTypeManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Segmenttypen verwalten"
        Width="780" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BpmBgWindow}"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BpmBgSurface}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Segmenttypen für Profil-Wizard"
                           Foreground="{DynamicResource BpmTextBright}"
                           FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource BpmTextSecondary}"
                           FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Text="Built-ins können umbenannt, umgefärbt und deaktiviert werden. Fachrolle und Token sind unveränderlich. Custom-Typen sind voll editierbar und können soft-gelöscht werden."/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource BpmBgWindow}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatsText"
                           Foreground="{DynamicResource BpmTextSecondary}"
                           FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="+ Neuer Segmenttyp"
                        Style="{DynamicResource BpmButtonPrimary}"
                        Command="{Binding CreateNewCustomCommand}"/>
            </Grid>
        </Border>

        <!-- Body: 2-Spalten -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LISTE -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource BpmBgWindow}"
                          BorderBrush="{DynamicResource BpmBorderDefault}"
                          BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <!-- Gruppen-Header -->
                                <Border Background="{DynamicResource BpmBgSurface}"
                                        Padding="12,8"
                                        BorderBrush="{DynamicResource BpmBorderDefault}"
                                        BorderThickness="0,1,0,1"
                                        Tag="{Binding Group}"
                                        MouseLeftButtonUp="OnGroupToggleClick"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Header}"
                                                   Foreground="{DynamicResource BpmTextBright}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource BpmTextSecondary}"
                                                   FontSize="10" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="aktiv"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Group.IsActive}" Value="False">
                                                            <Setter Property="Text" Value="deaktiviert"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BpmWarning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Items -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="20,5,12,5"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="OnTypeRowClick"
                                                    Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BpmBgHover}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Color-Swatch -->
                                                    <Border Grid.Column="0"
                                                            Width="14" Height="14"
                                                            CornerRadius="2"
                                                            Margin="0,0,8,0"
                                                            BorderBrush="#22FFFFFF" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding Color, Converter={StaticResource HexToColor}}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <!-- Name -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource BpmTextPrimary}"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                    <!-- Badges -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#37373D"
                                                                Padding="6,1" CornerRadius="3" Margin="6,0,0,0"
                                                                Visibility="{Binding IsBuiltin, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="BUILT-IN" Foreground="#858585" FontSize="9" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="#04395E"
                                                                Padding="6,1" CornerRadius="3" Margin="6,0,0,0"
                                                                Visibility="{Binding IsBuiltin, Converter={StaticResource InverseBoolToVis}}">
                                                            <TextBlock Text="EIGEN" Foreground="#3794FF" FontSize="9" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Button Content="○"
                                                                Margin="8,0,0,0"
                                                                Padding="6,0"
                                                                MinWidth="22" Height="20"
                                                                Background="Transparent"
                                                                Foreground="{DynamicResource BpmTextSecondary}"
                                                                BorderBrush="{DynamicResource BpmBorderDefault}"
                                                                BorderThickness="1"
                                                                FontSize="11"
                                                                Click="OnToggleTypeActiveClick"
                                                                Tag="{Binding}"
                                                                ToolTip="Aktivieren/Deaktivieren">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Content" Value="●"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource BpmAccentPrimary}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                            <Setter Property="Content" Value="○"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource BpmTextSecondary}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- EDIT-PANEL -->
            <Border Grid.Column="1" Background="{DynamicResource BpmBgSurface}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Segmenttyp bearbeiten"
                               Foreground="{DynamicResource BpmTextBright}"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <!-- Hint bei keiner Auswahl -->
                    <TextBlock Grid.Row="1"
                               Text="Wähle einen Segmenttyp aus der Liste links."
                               Foreground="{DynamicResource BpmTextSecondary}"
                               FontSize="11" TextWrapping="Wrap"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>

                    <!-- Edit-Form bei Auswahl -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Name"
                                       Foreground="{DynamicResource BpmTextSecondary}"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,5" Margin="0,0,0,10"
                                     FontSize="13"
                                     Background="{DynamicResource BpmBgInput}"
                                     Foreground="{DynamicResource BpmTextPrimary}"
                                     BorderBrush="{DynamicResource BpmBorderDefault}"/>

                            <!-- Fachrolle (read-only, nur Built-in) -->
                            <StackPanel Visibility="{Binding IsSelectionBuiltin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Fachrolle (read-only)"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource BpmBgInput}"
                                        BorderBrush="{DynamicResource BpmBorderDefault}" BorderThickness="1"
                                        CornerRadius="3" Padding="6,5" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SemanticRoleDisplay}"
                                               Foreground="{DynamicResource BpmTextPrimary}" FontSize="12"/>
                                </Border>
                                <TextBlock Text="{Binding SemanticRoleInfo}"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            </StackPanel>

                            <!-- Token (read-only) -->
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Token (read-only — für Templates)"
                                           Foreground="{DynamicResource BpmTextSecondary}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource BpmBgInput}"
                                        BorderBrush="{DynamicResource BpmBorderDefault}" BorderThickness="1"
                                        CornerRadius="3" Padding="6,5" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding TokenKeyDisplay}"
                                               FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource BpmAccentPrimary}"/>
                                </Border>
                            </StackPanel>

                            <!-- Gruppe -->
                            <TextBlock Text="Gruppe"
                                       Foreground="{DynamicResource BpmTextSecondary}"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableGroups}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding GroupIdDraft}"
                                      Padding="6,4" Margin="0,0,0,10"
                                      FontSize="12"/>

                            <!-- Farbe -->
                            <TextBlock Text="Farbe"
                                       Foreground="{DynamicResource BpmTextSecondary}"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Palette}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="6" Rows="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="32" Height="22" Margin="2" CornerRadius="3"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="OnColorPaletteClick"
                                                Tag="{Binding}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Converter={StaticResource HexToColor}}"/>
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Edit-Footer (Buttons) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                                Margin="0,8,0,0">
                        <Button Content="🗑 Löschen"
                                Style="{DynamicResource BpmButtonSecondary}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsSelectionCustom, Converter={StaticResource BoolToVis}}"
                                Foreground="{DynamicResource BpmError}"
                                Command="{Binding DeleteSelectedCustomCommand}"
                                ToolTip="Custom-Typ soft löschen — bleibt für bestehende Profile referenzierbar"/>
                        <Button Content="Verwerfen"
                                Style="{DynamicResource BpmButtonSecondary}"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding IsDirty}"
                                Command="{Binding CancelDraftCommand}"/>
                        <Button Content="Speichern"
                                Style="{DynamicResource BpmButtonPrimary}"
                                IsEnabled="{Binding IsDirty}"
                                Command="{Binding SaveDraftCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource BpmBgSurface}" Padding="16,10"
                BorderBrush="{DynamicResource BpmBorderDefault}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Schließen"
                        Style="{DynamicResource BpmButtonPrimary}"
                        Click="OnClose"
                        MinWidth="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
